FROM node:18-alpine AS builder

WORKDIR /app

# Copy workspace root files
COPY package.json package-lock.json tsconfig.base.json ./

# Copy shared package
COPY packages/shared ./packages/shared

# Copy server package
COPY server ./server

# Install dependencies
RUN npm ci --workspace=packages/shared --workspace=server

# Build shared package first, then server
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=server

# ---- Production stage ----
FROM node:18-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy built artifacts
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/server/dist ./server/dist
COPY --from=builder /app/server/package.json ./server/package.json
COPY --from=builder /app/server/src/database/migrations ./server/src/database/migrations

# Install production deps only
RUN npm ci --omit=dev --workspace=packages/shared --workspace=server

# Non-root user for security
RUN addgroup -g 1001 -S appgroup && adduser -S appuser -u 1001 -G appgroup
USER appuser

EXPOSE 3001

CMD ["node", "server/dist/server.js"]
